{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "torn-abroad-collector",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"],
  },
  "vars": {
    "RETENTION_DAYS": "90",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "torn-abroad-stock",
      // TODO: replace this with the id printed by `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
